<%- include('partials/header') %>

<article>
  <div class="container" style="max-width:800px;margin:0 auto;padding:40px 20px;">
    <% if (project.cover) { %>
      <picture>
        <source srcset="<%= webpOf(project.cover) %>" type="image/webp">
        <img src="<%= project.cover %>" alt="<%= project.title %>" style="width:100%;border-radius:12px;margin-bottom:24px;max-height:400px;object-fit:cover;">
      </picture>
    <% } %>

    <h1 style="font-size:2rem;margin-bottom:8px;"><%= project.title %></h1>

    <% if (project.tagList.length > 0) { %>
      <div style="margin-bottom:16px;display:flex;gap:8px;flex-wrap:wrap;">
        <% project.tagList.forEach(function(tag) { %>
          <span class="tag"><%= tag %></span>
        <% }) %>
      </div>
    <% } %>

    <p style="color:var(--text-light);margin-bottom:24px;font-size:1.1rem;"><%= project.description %></p>

    <div style="display:flex;gap:12px;margin-bottom:32px;">
      <% if (project.url) { %>
        <a href="<%= project.url %>" target="_blank" class="btn btn-primary">🔗 访问项目</a>
      <% } %>
      <% if (project.github) { %>
        <a href="<%= project.github %>" target="_blank" class="btn btn-outline">📂 查看源码</a>
      <% } %>
    </div>

    <div class="content-body markdown-body">
      <%- renderMarkdown(project.content) %>
    </div>

    <div style="margin-top:40px;">
      <a href="/projects" class="btn btn-outline">← 返回项目列表</a>
    </div>
  </div>
</article>

<%- include('partials/footer') %>
