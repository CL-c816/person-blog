<%- include('partials/header') %>
<div class="container">
  <div class="photo-detail">
    <div class="photo-detail-header">
      <h1 class="photo-detail-title"><%= photo.title || '未命名照片' %></h1>
      <div class="photo-detail-meta">
        <span><%= new Date(photo.created_at + 'Z').toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      </div>
    </div>

    <div class="photo-detail-image">
      <picture>
        <source srcset="<%= webpOf('/uploads/' + photo.filename) %>" type="image/webp">
        <img src="/uploads/<%= photo.filename %>" alt="<%= photo.title || '照片' %>" id="photoMain">
      </picture>
    </div>

    <% if (photo.description) { %>
      <p class="photo-detail-description"><%= photo.description %></p>
    <% } %>

    <div class="photo-nav">
      <% if (prevPhoto) { %>
        <a href="/album/<%= prevPhoto.id %>">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          上一张
        </a>
      <% } else { %>
        <a class="disabled">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          上一张
        </a>
      <% } %>
      <a href="/album" class="btn btn-outline btn-sm">返回相册</a>
      <% if (nextPhoto) { %>
        <a href="/album/<%= nextPhoto.id %>">
          下一张
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      <% } else { %>
        <a class="disabled">
          下一张
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      <% } %>
    </div>
  </div>
</div>

<script>
// 点击大图打开灯箱
document.getElementById('photoMain').addEventListener('click', function() {
  var lb = document.createElement('div');
  lb.className = 'lightbox';
  lb.innerHTML = '<img src="' + this.src + '" alt=""><button class="lightbox-close">&times;</button>';
  document.body.appendChild(lb);
  lb.addEventListener('click', function() { this.remove(); });
});
</script>
<%- include('partials/footer') %>
