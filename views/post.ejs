<%- include('partials/header') %>
<div class="container article-layout">
  <!-- 文章目录 TOC（桌面端右侧浮动，移动端折叠到顶部） -->
  <aside class="toc" id="toc" aria-label="文章目录">
    <div class="toc-title">目录</div>
    <nav class="toc-nav" id="tocNav"></nav>
  </aside>

  <article class="article">
    <% if (post.cover) { %>
    <div class="article-cover">
      <picture>
        <source srcset="<%= webpOf(post.cover) %>" type="image/webp">
        <img src="<%= post.cover %>" alt="<%= post.title %>">
      </picture>
    </div>
    <% } %>
    <div class="article-breadcrumb">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/blog">文章</a>
      <span>/</span>
      <span class="article-breadcrumb-current"><%= post.title %></span>
    </div>

    <header class="article-header">
      <h1 class="article-title"><%= post.title %></h1>
      <div class="article-meta">
        <span><%= new Date(post.created_at + 'Z').toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        <span><%= post.views %> 次阅读</span>
        <span class="reading-time"><%= Math.max(1, Math.ceil((post.content || '').length / 400)) %> 分钟阅读</span>
      </div>
        <% if (post.category) { %><div class="article-tags"><a href="/category/<%= encodeURIComponent(post.category) %>" class="category-pill"><%= post.category %></a></div><% } %>
        <% if (post.series) { %><div class="article-tags"><a href="/series/<%= encodeURIComponent(post.series) %>" class="category-pill series-pill"><%= post.series %></a></div><% } %>
        <% if (post.tagList && post.tagList.length > 0) { %>
        <div class="article-tags">
        <% post.tagList.forEach(function(tag) { %>
          <a href="/blog?tag=<%= encodeURIComponent(tag) %>" class="category-pill"><%= tag %></a>
        <% }) %>
      </div>
      <% } %>
    </header>

    <div class="article-body" id="articleBody">
      <%- renderMarkdown(post.content) %>
    </div>

    <div class="article-footer">
      <a href="/blog" class="btn btn-outline">← 返回博客</a>
    </div>

    <!-- 上一篇 / 下一篇 -->
    <nav class="post-nav" aria-label="上一篇与下一篇">
      <% if (prevPost) { %><a class="post-nav-item post-nav-prev" href="/blog/<%= prevPost.id %>"><span class="post-nav-dir">← 上一篇</span><span class="post-nav-title"><%= prevPost.title %></span></a><% } else { %><span class="post-nav-item post-nav-prev post-nav-empty"></span><% } %>
      <% if (nextPost) { %><a class="post-nav-item post-nav-next" href="/blog/<%= nextPost.id %>"><span class="post-nav-dir">下一篇 →</span><span class="post-nav-title"><%= nextPost.title %></span></a><% } else { %><span class="post-nav-item post-nav-next post-nav-empty"></span><% } %>
    </nav>

    <!-- 分享栏：复制链接 / 调起系统分享（纯前端，无需第三方 SDK） -->
    <div class="article-share" aria-label="分享文章">
      <span class="article-share-label">分享这篇：</span>
      <button type="button" class="share-btn" id="copyLinkBtn" data-url="<%= siteUrl + '/blog/' + post.id %>">复制链接</button>
      <button type="button" class="share-btn" id="shareBtn" data-url="<%= siteUrl + '/blog/' + post.id %>" data-title="<%= post.title %>">系统分享</button>
    </div>

    <!-- 相关推荐（同标签） -->
    <% if (relatedPosts && relatedPosts.length > 0) { %>
    <section class="related-posts">
      <h2 class="related-title">相关推荐</h2>
      <div class="related-grid">
        <% relatedPosts.forEach(function(rp) { %>
          <a class="related-card" href="/blog/<%= rp.id %>">
            <% if (rp.cover) { %><div class="related-cover"><picture><source srcset="<%= webpOf(rp.cover) %>" type="image/webp"><img src="<%= rp.cover %>" alt="<%= rp.title %>" loading="lazy"></picture></div><% } %>
            <div class="related-card-title"><%= rp.title %></div>
            <div class="related-card-meta"><%= rp.views %> 次阅读</div>
          </a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <!-- 扫码阅读 -->
    <% if (qrCode) { %>
    <div class="article-qr">
      <img src="<%= qrCode %>" alt="扫码阅读本文" width="140" height="140">
      <span class="article-qr-text">扫码用手机阅读 / 分享</span>
    </div>
    <% } %>

    <!-- Giscus 评论区（配置驱动：仅当后台填写了仓库才显示） -->
    <% if (config.giscus_repo) { %>
    <style>
      .giscus-comments { margin-top: 2.5rem; }
      .giscus-comments .section-title { font-size: 1.3rem; margin-bottom: 1rem; color: var(--text, #222); }
    </style>
    <section class="giscus-comments">
      <h2 class="section-title">评论</h2>
      <div class="giscus"></div>
    </section>
    <script>
    (function () {
      function blogTheme() {
        return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      }
      var s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.setAttribute('data-repo', '<%= config.giscus_repo %>');
      s.setAttribute('data-repo-id', '<%= config.giscus_repo_id %>');
      s.setAttribute('data-category', '<%= config.giscus_category %>');
      s.setAttribute('data-category-id', '<%= config.giscus_category_id %>');
      s.setAttribute('data-mapping', '<%= config.giscus_mapping || 'pathname' %>');
      s.setAttribute('data-reactions-enabled', '1');
      s.setAttribute('data-emit-metadata', '0');
      s.setAttribute('data-input-position', 'bottom');
      s.setAttribute('data-theme', blogTheme());
      s.setAttribute('data-lang', '<%= config.giscus_lang || 'zh-CN' %>');
      s.setAttribute('data-loading', 'lazy');
      s.crossOrigin = 'anonymous';
      s.async = true;
      document.body.appendChild(s);
      var mo = new MutationObserver(function () {
        var f = document.querySelector('.giscus iframe');
        if (f && f.contentWindow) {
          f.contentWindow.postMessage({ giscus: { setConfig: { theme: blogTheme() } } }, 'https://giscus.app');
        }
      });
      mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    })();
    </script>
    <% } %>

    <%- jsonLdArticle(post, config, siteUrl) %>

    <script>
    (function () {
      var copyBtn = document.getElementById('copyLinkBtn');
      var shareBtn = document.getElementById('shareBtn');
      function fallbackCopy(text, btn) {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); btn.textContent = '已复制 ✓'; }
        catch (e) { btn.textContent = '复制失败'; }
        document.body.removeChild(ta);
        setTimeout(function () { btn.textContent = '复制链接'; }, 1600);
      }
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var url = this.getAttribute('data-url');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () {
              copyBtn.textContent = '已复制 ✓';
              setTimeout(function () { copyBtn.textContent = '复制链接'; }, 1600);
            }).catch(function () { fallbackCopy(url, copyBtn); });
          } else { fallbackCopy(url, copyBtn); }
        });
      }
      if (shareBtn) {
        shareBtn.addEventListener('click', function () {
          var url = this.getAttribute('data-url');
          var title = this.getAttribute('data-title') || document.title;
          if (navigator.share) {
            navigator.share({ title: title, url: url }).catch(function () {});
          } else if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () {
              shareBtn.textContent = '链接已复制';
              setTimeout(function () { shareBtn.textContent = '系统分享'; }, 1600);
            });
          } else {
            fallbackCopy(url, shareBtn);
            shareBtn.textContent = '系统分享';
          }
        });
      }
    })();
    </script>
  </article>
</div>
<%- include('partials/footer') %>
