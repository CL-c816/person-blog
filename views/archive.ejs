<%- include('partials/header') %>
<div class="container archive-page">
  <header class="page-head">
    <h1 class="section-title">文章归档</h1>
    <p class="page-sub">共 <%= total %> 篇文章 · 按时间倒序</p>
  </header>

  <% archives.forEach(function(group) { %>
    <section class="archive-group">
      <h2 class="archive-ym"><%= group.ym %></h2>
      <ul class="archive-list">
        <% group.items.forEach(function(item) { %>
          <li class="archive-item">
            <span class="archive-date"><%= item.dateStr %></span>
            <a href="/blog/<%= item.id %>" class="archive-title"><%= item.title %></a>
            <span class="archive-views"><%= item.views %> 阅</span>
          </li>
        <% }) %>
      </ul>
    </section>
  <% }) %>

  <% if (archives.length === 0) { %>
    <p class="empty-state">还没有文章，去写一篇吧。</p>
  <% } %>
</div>
<%- include('partials/footer') %>
