<%- include('partials/header') %>
<div class="container">
  <div class="page-header">
    <h1 class="page-title">博客文章</h1>
    <p class="page-description">记录思考，分享生活</p>
  </div>

  <!-- 搜索 -->
  <div class="blog-search-bar">
    <svg class="blog-search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
    <input type="text" id="searchInput" class="blog-search-input" placeholder="搜索文章..." value="<%= currentSearch %>">
  </div>

  <!-- 分类标签 -->
  <% if (tags.length > 0) { %>
  <nav class="category-pills blog-category-pills" aria-label="文章分类">
    <span class="category-pills-indicator"></span>
    <a href="/blog" class="category-pill <%= !currentTag && !currentSearch ? 'active' : '' %>">全部</a>
    <% tags.forEach(function(tag) { %>
      <a href="/blog?tag=<%= encodeURIComponent(tag) %>" class="category-pill <%= currentTag === tag ? 'active' : '' %>"><%= tag %></a>
    <% }) %>
  </nav>
  <% } %>

  <!-- 当前筛选状态条 -->
  <% if (currentTag || currentSearch) { %>
  <div class="filter-status">
    <span class="filter-status-text">
      <% if (currentSearch) { %>搜索 “<strong><%= currentSearch %></strong>”<% } %>
      <% if (currentTag) { %>分类 <strong><%= currentTag %></strong><% } %>
      共 <%= posts.length %> 篇
    </span>
    <a href="/blog" class="filter-clear">清空筛选 ✕</a>
  </div>
  <% } %>

  <!-- 文章列表 -->
  <div class="article-list">
    <% if (posts.length === 0) { %>
      <div class="empty-state"><p>没有找到匹配的文章</p></div>
    <% } %>
    <% posts.forEach(function(post) { %>
      <article class="article-list-card">
        <% if (post.cover) { %>
          <a href="/blog/<%= post.id %>" class="article-list-cover">
            <picture>
              <source srcset="<%= webpOf(post.cover) %>" type="image/webp">
              <img src="<%= post.cover %>" alt="<%= post.title %>" loading="lazy">
            </picture>
          </a>
        <% } %>
        <div class="article-list-body">
          <div class="article-list-breadcrumb">
            <% var tagList = (post.tags || '').split(',').filter(Boolean); %>
            <% if (post.category) { %><span class="post-cat"><a href="/category/<%= encodeURIComponent(post.category) %>" class="category-pill"><%= post.category %></a></span><% if (tagList.length) { %> / <% } %><% } %>
            <% if (tagList.length > 0) { %>
              <%= tagList.join(' / ') %>
            <% } else if (!post.category) { %>
              未分类
            <% } %>
          </div>
          <h3 class="article-list-title"><a href="/blog/<%= post.id %>"><%= post.title %></a></h3>
          <p class="article-list-excerpt"><%= excerpt(post.content, 60) %></p>
          <div class="article-list-meta">
            <span><%= new Date(post.created_at + 'Z').toLocaleDateString('zh-CN') %></span>
            <span><%= post.views %> 次阅读</span>
            <span class="reading-time"><%= Math.max(1, Math.ceil((post.content || '').length / 400)) %> 分钟</span>
          </div>
        </div>
      </article>
    <% }) %>
  </div>

  <!-- 热门文章 -->
  <% if (locals.popularPosts && popularPosts.length > 0) { %>
  <section class="section popular-section">
    <h2 class="section-title">热门文章</h2>
    <div class="popular-list">
      <% popularPosts.forEach(function(p, i) { %>
        <a class="popular-item" href="/blog/<%= p.id %>">
          <span class="popular-rank"><%= i + 1 %></span>
          <span class="popular-title"><%= p.title %></span>
          <span class="popular-views"><%= p.views %> 阅读</span>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

</div>

<script>
(function() {
  var input = document.getElementById('searchInput');
  if (!input) return;
  var cards = Array.prototype.slice.call(document.querySelectorAll('.article-list .article-list-card'));
  var emptyState = document.querySelector('.blog-empty-state');
  function filter() {
    var q = input.value.trim().toLowerCase();
    var shown = 0;
    cards.forEach(function(c) {
      var title = (c.querySelector('.article-list-title') || {}).textContent || '';
      var excerpt = (c.querySelector('.article-list-excerpt') || {}).textContent || '';
      var hit = !q || (title + ' ' + excerpt).toLowerCase().indexOf(q) !== -1;
      c.style.display = hit ? '' : 'none';
      if (hit) shown++;
    });
    if (emptyState) emptyState.style.display = shown === 0 ? '' : 'none';
  }
  input.addEventListener('input', filter);
  input.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      window.location.href = '/blog?search=' + encodeURIComponent(input.value.trim());
    }
  });
})();
</script>
<%- include('partials/footer') %>
