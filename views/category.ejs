<%- include('partials/header') %>
<div class="container tags-page">
  <header class="page-head">
    <h1 class="section-title">全部分类</h1>
    <p class="page-sub">按主题浏览文章</p>
  </header>
  <div class="tag-cloud">
    <% categories.forEach(function(c) { %>
      <a href="/category/<%= encodeURIComponent(c.category) %>" class="tag-cloud-item" style="font-size:<%= (0.95 + Math.min(c.count, 8) * 0.12).toFixed(2) %>rem;">
        <%= c.category %> <span class="tag-count"><%= c.count %></span>
      </a>
    <% }) %>
  </div>
  <% if (categories.length === 0) { %>
    <p class="empty-state">还没有分类。去后台发布文章时填写「分类」即可。</p>
  <% } %>
</div>
<%- include('partials/footer') %>
