<%- include('partials/header') %>
<div class="container">
  <div class="page-header">
    <h1 class="page-title">分类：<%= category %></h1>
    <p class="page-description">共 <%= posts.length %> 篇文章 · <a href="/category">全部分类</a></p>
  </div>

  <div class="article-list">
    <% if (posts.length === 0) { %>
      <div class="empty-state"><p>该分类下还没有文章</p></div>
    <% } %>
    <% posts.forEach(function(post) { %>
      <article class="article-list-card">
        <% if (post.cover) { %>
          <a href="/blog/<%= post.id %>" class="article-list-cover">
            <picture>
              <source srcset="<%= webpOf(post.cover) %>" type="image/webp">
              <img src="<%= post.cover %>" alt="<%= post.title %>" loading="lazy">
            </picture>
          </a>
        <% } %>
        <div class="article-list-body">
          <div class="article-list-breadcrumb">
            <% var tagList = (post.tags || '').split(',').filter(Boolean); %>
            <% if (post.category) { %><span class="post-cat"><a href="/category/<%= encodeURIComponent(post.category) %>"><%= post.category %></a></span><% if (tagList.length) { %> / <% } %><% } %>
            <% if (tagList.length > 0) { %>
              <%= tagList.join(' / ') %>
            <% } else if (!post.category) { %>
              未分类
            <% } %>
          </div>
          <h3 class="article-list-title"><a href="/blog/<%= post.id %>"><%= post.title %></a></h3>
          <p class="article-list-excerpt"><%= excerpt(post.content, 60) %></p>
          <div class="article-list-meta">
            <span><%= new Date(post.created_at + 'Z').toLocaleDateString('zh-CN') %></span>
            <span><%= post.views %> 次阅读</span>
            <span class="reading-time"><%= Math.max(1, Math.ceil((post.content || '').length / 400)) %> 分钟</span>
          </div>
        </div>
      </article>
    <% }) %>
  </div>
</div>
<%- include('partials/footer') %>
