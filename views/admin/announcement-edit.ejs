<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>编辑公告 - 个人空间</title>
  <link rel="icon" href="/uploads/avatar.png">
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700;900&family=Noto+Sans+SC:wght@300;400;500;700;900&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="navbar scrolled">
    <div class="container nav-container">
      <a href="/" class="nav-logo">返回站点</a>
      <ul class="nav-menu">
        <li><a href="/admin" class="nav-link">仪表盘</a></li>
        <li><a href="/admin/logout" class="nav-link nav-logout">退出</a></li>
      </ul>
    </div>
  </nav>

  <main class="main-content">
    <div class="container">
      <div class="admin-card">
        <div class="admin-card-header">
          <h2 class="admin-card-title">编辑公告</h2>
        </div>
        <div class="admin-card-body">
          <% if (locals.error_msg && error_msg.length) { %><div class="alert alert-error"><%= error_msg %></div><% } %>
          <form method="POST" action="/admin/announcement/<%= ann.id %>">
            <div class="form-group">
              <label>标题（可选，默认"公告"）</label>
              <input type="text" name="title" value="<%= ann.title || '' %>" placeholder="例如：站点维护通知">
            </div>
            <div class="form-group">
              <label>内容</label>
              <textarea name="content" rows="4" required placeholder="写一条想告诉访客的公告…"><%= ann.content || '' %></textarea>
            </div>
            <label class="checkbox-label">
              <input type="checkbox" name="pinned" value="1" <%= ann.pinned ? 'checked' : '' %>> 置顶展示
            </label>
            <div style="margin-top:16px;display:flex;gap:10px;">
              <button type="submit" class="btn btn-primary btn-sm">保存修改</button>
              <a href="/admin#announcements" class="btn btn-sm btn-outline">取消</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container"><p>&copy; 2024 个人空间管理后台</p></div>
  </footer>
</body>
</html>
