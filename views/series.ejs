<%- include('partials/header') %>
<div class="container tags-page">
  <header class="page-head">
    <h1 class="section-title">全部系列</h1>
    <p class="page-sub">按系列阅读连贯内容</p>
  </header>
  <div class="tag-cloud">
    <% series.forEach(function(s) { %>
      <a href="/series/<%= encodeURIComponent(s.series) %>" class="tag-cloud-item" style="font-size:<%= (0.95 + Math.min(s.count, 8) * 0.12).toFixed(2) %>rem;">
        <%= s.series %> <span class="tag-count"><%= s.count %></span>
      </a>
    <% }) %>
  </div>
  <% if (series.length === 0) { %>
    <p class="empty-state">还没有系列。去后台发布文章时填写「系列」即可。</p>
  <% } %>
</div>
<%- include('partials/footer') %>
