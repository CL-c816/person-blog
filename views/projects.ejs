<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="page-header">
      <h1 class="page-title">项目展示</h1>
    </div>

    <% if (projects.length === 0) { %>
      <div class="empty-state"><p>还没有项目展示</p></div>
    <% } else { %>
      <div class="project-grid">
        <% projects.forEach(function(project) { %>
          <a href="/projects/<%= project.id %>" class="project-card">
            <% if (project.cover) { %>
              <div class="project-card-cover">
                <picture>
                  <source srcset="<%= webpOf(project.cover) %>" type="image/webp">
                  <img src="<%= project.cover %>" alt="<%= project.title %>" loading="lazy">
                </picture>
              </div>
            <% } %>
            <div class="project-card-body">
              <h3 class="project-card-title"><%= project.title %></h3>
              <p class="project-card-desc"><%= project.description %></p>
              <% if (project.tags) { %>
                <div class="project-card-tags">
                  <% project.tags.split(',').forEach(function(tag) { %>
                    <span class="tag"><%= tag.trim() %></span>
                  <% }) %>
                </div>
              <% } %>
              <div class="project-card-links">
                <% if (project.url) { %><a href="<%= project.url %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline">访问</a><% } %>
                <% if (project.github) { %><a href="<%= project.github %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline">源码</a><% } %>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
